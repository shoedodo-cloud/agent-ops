#!/usr/bin/env python3
"""secret-sweep: look for credentials in the git repos under a directory.

Agents commit fast. A credential-shaped file or token can land in a repo before anyone
reads the diff. This tool scans the tracked files of every git repo under a root (or,
with --history, every blob reachable from any ref) for credential-shaped file names and
token patterns.

It is read-only. It never edits, commits or deletes anything. It never prints any
character of a match: a hit is reported as a pattern name, a repo and a path, plus the
first commit that contained it when --history is used.

It is a backstop, not permission. A clean sweep means these patterns were not found.
It does not mean the repo is safe to publish.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

# --- Detection rules -------------------------------------------------------------

# File names. Matched against the repo-relative path with / separators.
SECRET_FILE = re.compile(
    r"(^|/)(\.env(\..+)?|id_rsa|id_dsa|id_ecdsa|id_ed25519|.*\.pem|.*\.p12|.*\.pfx|.*\.key|"
    r".*credential.*\.json|.*[_-]?token.*\.txt|.*\.keychain(-db)?|"
    r"\.npmrc|\.netrc|\.pypirc|\.git-credentials|.*\.kdbx|.*\.jks|service[_-]?account.*\.json)$", re.I)
# Conventional placeholder files. Exempt by name only. Their content is still scanned.
SECRET_FILE_EXEMPT = re.compile(r"(^|/)\.env\.(example|sample|template|dist)$", re.I)
FILENAME_RULE = "credential-filename"

# Content. Bytes patterns, so a blob never has to be decoded and cannot crash the scan.
CONTENT_RULES = [
    ("anthropic-key", re.compile(rb"sk-ant-[A-Za-z0-9_-]{16}")),
    ("openai-key", re.compile(rb"\bsk-(?!ant-)[A-Za-z0-9_-]{40,}")),
    ("github-token", re.compile(rb"gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{40,}")),
    ("aws-access-key-id", re.compile(rb"AKIA[0-9A-Z]{16}")),
    ("slack-token", re.compile(rb"xox[baprs]-[A-Za-z0-9-]{10,}")),
    ("google-api-key", re.compile(rb"AIza[0-9A-Za-z_\-]{30,}")),
    ("linear-api-key", re.compile(rb"lin_api_[A-Za-z0-9]{32,}")),
    ("stripe-live-key", re.compile(rb"\b[sr]k_live_[A-Za-z0-9]{20,}")),
    ("gitlab-token", re.compile(rb"glpat-[A-Za-z0-9_\-]{20,}")),
    ("npm-token", re.compile(rb"\bnpm_[A-Za-z0-9]{36}")),
    ("huggingface-token", re.compile(rb"\bhf_[A-Za-z0-9]{30,}")),
    ("pypi-token", re.compile(rb"pypi-AgEIcHlwaS5vcmc[A-Za-z0-9_\-]{50,}")),
    ("url-credentials", re.compile(rb"\b[a-z][a-z0-9+.\-]*://[^\s:/@\"'<>]+:[^\s:/@\"'<>]{6,}@[A-Za-z0-9.\-]", re.I)),
    ("private-key-header", re.compile(rb"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("generic-api-key", re.compile(
        rb"api[_-]?key[\"']?\s*[:=]\s*[\"']?(?=[A-Za-z_\-+]*\d)[A-Za-z0-9_\-+]{20,}", re.I)),
]

CHUNK = 1 << 20      # bytes read at a time
OVERLAP = 512        # kept between chunks so a token on a chunk boundary is still seen
ZERO_SHA = re.compile(r"^0+$")
SHA = re.compile(r"^[0-9a-f]{40}([0-9a-f]{24})?$")
MAX_DEPTH = 3        # how far below the root to look for repos

EXIT_CLEAN, EXIT_HITS, EXIT_ERROR = 0, 1, 2
NOTHING = "0 files scanned, nothing to conclude"

EPILOG = """\
root:
  The directory to sweep. Give it as an argument or set SWEEP_ROOT. There is no default.
  If the root is itself a git repo, only that repo is swept. Otherwise every repo found
  up to %d levels below it is swept. Symlinked directories are not followed.

modes:
  default    The tracked files of each repo, as they are on disk now.
  --history  Every blob reachable from any ref, including files since deleted. Slow.

patterns (a hit names one of these, never the matched text):
  %s
  %s  (a name match, see below)

  File names: .env and .env.*, id_rsa, id_dsa, id_ecdsa, id_ed25519, *.pem, *.p12, *.pfx,
  *.key, *credential*.json, *token*.txt, *.keychain, *.keychain-db, .npmrc, .netrc,
  .pypirc, .git-credentials, *.kdbx, *.jks, service-account*.json. The placeholders
  .env.example, .env.sample, .env.template and .env.dist are not reported by name.
  Their content is still scanned.

  A hit is one per file and pattern. In --history mode it carries the first commit
  that contained it.

exit codes:
  0  clean: every repo was scanned, at least one file was read, and nothing matched
  1  one or more hits
  2  error: bad arguments, no repos found, a repo could not be scanned, or every
     repo had zero files to scan ("0 files scanned, nothing to conclude").
     A repo that could not be scanned is not clean. Hits found elsewhere are still
     printed, and the exit code is 2.

The output lists the files scanned per repo and in the summary line. A repo with zero
files among others is reported as "0 files scanned, nothing to conclude" and does not
change the exit code. In --history mode each distinct file version (blob) counts once.

A hit is not always a live credential. Treat it as one until checked. Revoke the
credential first, then remove the file, then decide about the history. Deleting a file
does not remove it from clones or from remotes it was pushed to.
""" % (MAX_DEPTH, ", ".join(n for n, _ in CONTENT_RULES), FILENAME_RULE)


class SweepError(Exception):
    """A check could not be completed. Never swallowed: it ends in exit code 2."""


# --- small helpers ---------------------------------------------------------------

def safe(text):
    """Make untrusted text (a file name) safe to print: no control characters."""
    text = text.encode("utf-8", "backslashreplace").decode("utf-8")
    return "".join("?" if (ord(c) < 32 or ord(c) == 127) else c for c in text)


def is_secret_name(path):
    return bool(SECRET_FILE.search(path)) and not SECRET_FILE_EXEMPT.search(path)


def scan_stream(read):
    """Return the set of content pattern names found in a byte stream.

    read(n) returns up to n bytes and b"" at the end. The whole stream is read.
    """
    found = set()
    tail = b""
    while True:
        chunk = read(CHUNK)
        if not chunk:
            return found
        buf = tail + chunk
        for name, rx in CONTENT_RULES:
            if name not in found and rx.search(buf):
                found.add(name)
        tail = buf[-OVERLAP:]


def git_env(repo):
    env = dict(os.environ)
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["GIT_OPTIONAL_LOCKS"] = "0"
    # Never wander up into a different repo if this one's .git is broken.
    env["GIT_CEILING_DIRECTORIES"] = os.path.dirname(os.path.abspath(repo))
    return env


def first_line(data):
    text = data.decode("utf-8", "replace").strip()
    return safe(text.splitlines()[0]) if text else ""


def run_git(repo, args):
    p = subprocess.run(["git", "-C", repo] + list(args), stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, env=git_env(repo))
    if p.returncode != 0:
        raise SweepError("git %s failed: %s" % (args[0], first_line(p.stderr) or p.returncode))
    return p.stdout


class GitStream:
    """Run git and stream its stdout. Raises SweepError if git fails."""

    def __init__(self, repo, args):
        self.repo, self.args = repo, list(args)

    def __enter__(self):
        self.err = tempfile.TemporaryFile()
        self.p = subprocess.Popen(["git", "-C", self.repo] + self.args,
                                  stdout=subprocess.PIPE, stderr=self.err,
                                  env=git_env(self.repo))
        return self.p.stdout

    def __exit__(self, exc_type, exc, tb):
        self.p.stdout.close()
        code = self.p.wait()
        self.err.seek(0)
        msg = first_line(self.err.read())
        self.err.close()
        if exc_type is None and code != 0:
            raise SweepError("git %s failed: %s" % (self.args[0], msg or code))
        return False


def nul_tokens(stream):
    buf = b""
    while True:
        chunk = stream.read(1 << 16)
        if not chunk:
            break
        parts = (buf + chunk).split(b"\0")
        buf = parts.pop()
        for part in parts:
            yield part
    if buf:
        yield buf


class BlobReader:
    """One long-lived `git cat-file --batch`. Content is streamed as bytes."""

    def __init__(self, repo):
        self.err = tempfile.TemporaryFile()
        self.p = subprocess.Popen(["git", "-C", repo, "cat-file", "--batch"],
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=self.err, env=git_env(repo))
        self.left = 0

    def _fail(self, what):
        self.err.seek(0)
        raise SweepError("git cat-file %s: %s" % (what, first_line(self.err.read()) or "no output"))

    def header(self, sha):
        """Ask for an object. Returns (type, size), or (None, 0) if it is missing."""
        try:
            self.p.stdin.write(sha.encode("ascii") + b"\n")
            self.p.stdin.flush()
        except (BrokenPipeError, OSError):
            self._fail("stopped unexpectedly")
        parts = self.p.stdout.readline().split()
        if len(parts) == 2 and parts[1] == b"missing":
            return None, 0
        if len(parts) != 3 or not parts[2].isdigit():
            self._fail("returned unexpected output")
        self.left = int(parts[2])
        return parts[1].decode("ascii", "replace"), self.left

    def read(self, n):
        n = min(n, self.left)
        if n <= 0:
            return b""
        data = self.p.stdout.read(n)
        if not data:
            self._fail("ended inside an object")
        self.left -= len(data)
        return data

    def finish(self):
        """Discard whatever is left of the current object, and the trailing newline."""
        while self.left > 0:
            self.read(CHUNK)
        self.p.stdout.read(1)

    def close(self):
        try:
            self.p.stdin.close()
        except OSError:
            pass
        self.p.stdout.close()
        self.p.wait()
        self.err.close()


# --- scanning --------------------------------------------------------------------

def hit(repo, path, pattern, commit=None):
    return {"repo": repo, "path": path, "pattern": pattern, "commit": commit}


def scan_worktree(repo, name, stats):
    hits = []
    for raw in run_git(repo, ["ls-files", "-z"]).split(b"\0"):
        if not raw:
            continue
        path = os.fsdecode(raw)
        full = os.path.join(repo, path)
        if is_secret_name(path):
            hits.append(hit(name, path, FILENAME_RULE))
        if os.path.islink(full) or os.path.isdir(full):   # symlinks and submodules
            continue
        try:
            with open(full, "rb") as f:
                found = scan_stream(f.read)
        except OSError:
            stats["unreadable"] += 1     # e.g. tracked but deleted from disk
            continue
        stats["files"] += 1
        hits.extend(hit(name, path, p) for p in sorted(found))
    return hits


def history_index(repo):
    """Walk every commit once. Returns (blobs, names).

    blobs: {blob sha: [first commit, path]}, oldest first.
    names: {path: first commit} for credential-shaped file names.
    """
    blobs, names = {}, {}
    commit, state, new_mode, new_sha = None, "any", "", ""
    args = ["log", "--all", "--root", "--reverse", "-m", "--raw", "--no-abbrev",
            "--no-renames", "-z", "--format=commit:%H"]
    with GitStream(repo, args) as out:
        for raw in nul_tokens(out):
            if state == "path":
                state = "any"
                path = os.fsdecode(raw)
                if SHA.match(new_sha) and not ZERO_SHA.match(new_sha) and new_mode != "160000":
                    blobs.setdefault(new_sha, [commit, path])
                    if is_secret_name(path):
                        names.setdefault(path, commit)
                continue
            tok = raw.lstrip(b"\n")
            if tok.startswith(b"commit:"):
                commit = tok[7:].decode("ascii", "replace")
            elif tok.startswith(b":"):
                fields = tok[1:].decode("ascii", "replace").split()
                if len(fields) >= 4:
                    new_mode, new_sha, state = fields[1], fields[3], "path"
    return blobs, names


def scan_history(repo, name, stats):
    """Every blob reachable from any ref. Read as bytes, matched with bytes patterns."""
    blobs, names = history_index(repo)
    objects = dict(blobs)
    with GitStream(repo, ["rev-list", "--objects", "--all"]) as out:
        for line in out:                      # backstop: anything the log walk missed
            sha, _, path = line.rstrip(b"\n").decode("utf-8", "surrogateescape").partition(" ")
            if SHA.match(sha) and path and sha not in objects:
                objects[sha] = [None, path]
    hits, seen = [], set()

    def add(path, pattern, commit):
        if (path, pattern) not in seen:
            seen.add((path, pattern))
            hits.append(hit(name, path, pattern, commit))

    for path, commit in names.items():
        add(path, FILENAME_RULE, commit)
    reader = BlobReader(repo)
    try:
        for sha, (commit, path) in objects.items():
            kind, _size = reader.header(sha)
            if kind != "blob":
                if kind is not None:
                    reader.finish()
                continue
            if sha not in blobs and is_secret_name(path):
                add(path, FILENAME_RULE, commit)
            for pattern in sorted(scan_stream(reader.read)):
                add(path, pattern, commit)
            stats["files"] += 1
            reader.finish()
    finally:
        reader.close()
    return hits


def find_repos(root):
    if os.path.exists(os.path.join(root, ".git")):
        return [root]
    repos = []
    base_depth = root.rstrip(os.sep).count(os.sep)
    for here, dirs, _files in os.walk(root):
        dirs.sort()
        if os.path.exists(os.path.join(here, ".git")):
            repos.append(here)
            dirs[:] = []
            continue
        if here.rstrip(os.sep).count(os.sep) - base_depth >= MAX_DEPTH:
            dirs[:] = []
    return repos


# --- output ----------------------------------------------------------------------

def render_text(result):
    out = []
    by_repo = {}
    for h in result["hits"]:
        by_repo.setdefault(h["repo"], []).append(h)
    for repo, hs in by_repo.items():
        out.append("")
        out.append("%s  (%d hit%s)" % (safe(repo), len(hs), "" if len(hs) == 1 else "s"))
        for h in hs:
            line = "  %s  %s" % (safe(h["path"]), h["pattern"])
            if h["commit"]:
                line += "  commit %s" % h["commit"][:12]
            out.append(line)
    out.append("")
    out.append("files scanned per repo:")
    for repo, n in result["repo_files"].items():
        out.append("  %s: %s" % (safe(repo), "%d file(s)" % n if n else NOTHING))
    scope = "history" if result["mode"] == "history" else "tracked files"
    out.append("%d hit(s) in %d repo(s) scanned, %d file(s) [%s under %s]" % (
        len(result["hits"]), result["repos_scanned"], result["files_scanned"], scope,
        safe(result["root"])))
    if result["unreadable"]:
        out.append("%d tracked file(s) could not be read and were checked by name only." %
                   result["unreadable"])
    if result["nothing_scanned"]:
        out.append("ERROR: every repo had %s. This is not a clean result." % NOTHING)
    if result["errors"]:
        out.append("ERROR: %d repo(s) could not be scanned. They are not clean." %
                   len(result["errors"]))
    if result["hits"]:
        out.append("A hit is not always a live credential. Treat it as one until checked.\n"
                   "Revoke it first, then remove the file, then decide about the history.\n"
                   "Deleting a file does not remove it from clones or remotes.")
    return "\n".join(out)


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="secret-sweep", formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Scan the git repos under a root for credential-shaped files and tokens. "
                    "Read-only. Never prints any part of a match.",
        epilog=EPILOG)
    ap.add_argument("root", nargs="?", help="directory to sweep (or set SWEEP_ROOT)")
    ap.add_argument("--history", action="store_true",
                    help="scan every blob reachable from any ref instead of tracked files (slow)")
    ap.add_argument("--json", action="store_true", help="print one JSON object instead of text")
    args = ap.parse_args(argv)

    root = args.root or os.environ.get("SWEEP_ROOT")
    result = {"tool": "secret-sweep", "mode": "history" if args.history else "tracked-files",
              "root": root or "", "repos_scanned": 0, "files_scanned": 0, "repo_files": {},
              "nothing_scanned": False, "hits": [], "errors": [], "unreadable": 0,
              "exit": EXIT_ERROR}
    stats = {"unreadable": 0, "files": 0}

    try:
        if not root:
            raise SweepError("no root given. Pass a directory or set SWEEP_ROOT.")
        if not os.path.isdir(root):
            raise SweepError("root is not a directory: %s" % safe(root))
        if shutil.which("git") is None:
            raise SweepError("git was not found on PATH.")
        repos = find_repos(root)
        if not repos:
            raise SweepError("no git repositories found under %s" % safe(root))
    except SweepError as e:
        result["errors"].append({"repo": None, "message": str(e)})
        return emit(result, args)

    for repo in repos:
        rel = os.path.relpath(repo, root)
        name = os.path.basename(os.path.abspath(root)) if rel == "." else rel
        before = stats["files"]
        try:
            scan = scan_history if args.history else scan_worktree
            result["hits"].extend(scan(repo, name, stats))
            result["repos_scanned"] += 1
            result["repo_files"][name] = stats["files"] - before
        except SweepError as e:
            stats["files"] = before
            result["errors"].append({"repo": name, "message": str(e)})
    result["unreadable"] = stats["unreadable"]
    result["files_scanned"] = stats["files"]
    # Repos were entered but not one file was read: that is no evidence of anything.
    result["nothing_scanned"] = result["repos_scanned"] > 0 and stats["files"] == 0
    return emit(result, args)


def emit(result, args):
    if result["errors"] or result["nothing_scanned"]:
        code = EXIT_ERROR
    elif result["hits"]:
        code = EXIT_HITS
    else:
        code = EXIT_CLEAN
    result["exit"] = code
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        if not any(e["repo"] is None for e in result["errors"]):
            print(render_text(result))
        for e in result["errors"]:
            where = "%s: " % safe(e["repo"]) if e["repo"] else ""
            print("secret-sweep: error: %s%s" % (where, e["message"]), file=sys.stderr)
        if result["nothing_scanned"]:
            print("secret-sweep: error: every repo under %s had %s" % (safe(result["root"]), NOTHING),
                  file=sys.stderr)
    return code


if __name__ == "__main__":
    sys.exit(main())
