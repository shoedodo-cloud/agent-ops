#!/usr/bin/env python3
"""session-wrap: write a dated session note and, with --post, send its next line to the tracker."""
from __future__ import annotations

import argparse
import datetime as dt
import os
import string
import sys
from pathlib import Path

HELP = """\
Write <notes>/<YYYY-MM-DD>_<HHMM>_session.md for the current repo, with four sections:
What changed, Decisions, Next session starts here, Open questions.

"What changed" is seeded from `git log` since the session start. The start comes from
--since, else $SESSION_START_TIME, else the harness transcript named in a hook payload on
stdin (Claude Code sends one), else the time of the last session note, else 24 hours ago.
The note says which one it used.

The next line comes from --next, or from plain text on stdin. A JSON object on stdin is
read as a harness hook payload instead (its cwd and transcript_path are used).

Tracker: without --post it only prints what it would send. With --post it sends the
"Next session starts here" line to the configured tracker (a comment or a new item).
Nothing is sent when there is no next line.

Exit status: 0 note written (or skipped by --skip-if-noted), 1 the note could not be
written or --post failed, 2 bad command line.

Environment:
  SESSION_NOTES_DIR      notes folder, relative to the repo root (default notes/sessions)
  SESSION_START_TIME     session start, ISO 8601 or Unix seconds (optional)
  SESSION_PROJECT        project name for the tracker (default: the repo folder name)
  SESSION_HOOKS_CONFIG   config file (default $HOME/.config/session-hooks/config.json)
  SESSION_HOOKS_TRACKERS extra folder(s) with tracker adapters, searched first
  SESSION_LEDGER         ledger file for the file tracker (default notes/ledger.md)
  SESSION_HOOKS_HOME     the session-hooks folder, if this script was copied out of it

Template placeholders (config "note_template" points at your own file):
  $project $date $time $branch $head $since $changes $decisions $next $questions
"""

DEFAULT_TEMPLATE = """\
# Session note: $project, $date $time

Branch $branch at $head. Written by session-wrap, edit freely.

## What changed
$changes

## Decisions
$decisions

## Next session starts here
$next

## Open questions
$questions
"""


def _module_home() -> Path | None:
    candidates = []
    if os.environ.get("SESSION_HOOKS_HOME"):
        candidates.append(Path(os.path.expanduser(os.environ["SESSION_HOOKS_HOME"])))
    candidates.append(Path(__file__).resolve().parent.parent)
    for home in candidates:
        if (home / "lib" / "sessionhooks.py").is_file() and (home / "trackers" / "base.py").is_file():
            return home
    return None


def _bullets(values: list[str], empty: str) -> str:
    cleaned = [" ".join(v.split()) for v in values if v and v.strip()]
    return "\n".join(f"- {v}" for v in cleaned) if cleaned else f"- {empty}"


def _changes(sh, root: Path | None, since) -> tuple[str, int]:
    """(markdown block, uncommitted count or -1)."""
    if root is None:
        return "- could not determine: git history (not inside a git work tree)", -1
    lines = [f"Commits on this branch {since.label}:"]
    log = sh.git_out(root, "log", f"--since={since.git_since}", "--pretty=format:%h %s")
    if log is None:
        has_head = sh.git_out(root, "rev-parse", "--verify", "--quiet", "HEAD")
        lines.append("- no commits yet" if not has_head else "- could not determine: git log failed")
    elif not log.strip():
        lines.append("- none")
    else:
        lines.extend(f"- {line}" for line in log.splitlines() if line.strip())
    status = sh.git_out(root, "status", "--porcelain=v1", "--untracked-files=normal")
    if status is None:
        lines.append("")
        lines.append("Uncommitted at wrap time: could not determine (git status failed).")
        return "\n".join(lines), -1
    count = len([s for s in status.splitlines() if s.strip()])
    lines.append("")
    lines.append(f"Uncommitted at wrap time: {count} path{'s' if count != 1 else ''}.")
    return "\n".join(lines), count


def _note_path(folder: Path, now: dt.datetime) -> Path:
    stem = now.strftime("%Y-%m-%d_%H%M") + "_session"
    path = folder / f"{stem}.md"
    n = 2
    while path.exists():
        path = folder / f"{stem}_{n}.md"
        n += 1
    return path


def _template(sh, config, base: Path) -> tuple[str, str]:
    """(template text, problem or '')."""
    raw = str(config.data.get("note_template") or "").strip()
    if not raw:
        return DEFAULT_TEMPLATE, ""
    path = Path(os.path.expanduser(raw))
    path = path if path.is_absolute() else base / path
    try:
        return path.read_text(encoding="utf-8"), ""
    except OSError as exc:
        return DEFAULT_TEMPLATE, f"note_template {path} unreadable ({exc.strerror or exc}), used the built-in one"


def run(argv: list[str] | None = None, stdin=None) -> int:
    parser = argparse.ArgumentParser(
        prog="session-wrap", description=HELP, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--repo", default="", help="repo to wrap (default: hook cwd, else current directory)")
    parser.add_argument("--next", default=None, help='the "Next session starts here" line')
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--since", default=None, help="git log start, e.g. 2026-01-31T09:00 or '3 hours ago'")
    group.add_argument("--since-start", action="store_true",
                       help="find the session start automatically (the default when --since is absent)")
    parser.add_argument("--decision", action="append", default=[], help="a decision taken (repeatable)")
    parser.add_argument("--question", action="append", default=[], help="an open question (repeatable)")
    parser.add_argument("--project", default="", help="project name for the tracker (default: repo folder name)")
    parser.add_argument("--skip-if-noted", action="store_true",
                        help="do nothing when a note was already written after the session start")
    parser.add_argument("--post", action="store_true", help="send the next line to the tracker (default: print only)")
    args = parser.parse_args(argv)

    home = _module_home()
    if home is None:
        print("session-wrap: lib/ and trackers/ not found next to this script. Install with a symlink, "
              "or set SESSION_HOOKS_HOME to the session-hooks folder", file=sys.stderr)
        return 1
    for path in (str(home), str(home / "lib")):
        if path not in sys.path:
            sys.path.insert(0, path)
    import sessionhooks as sh
    from trackers.base import TrackerError

    env = dict(os.environ)
    hook, piped = sh.split_stdin(sh.read_stdin(sys.stdin if stdin is None else stdin))
    next_text = (args.next if args.next is not None else piped).strip()

    start_dir = args.repo or (hook.get("cwd") if isinstance(hook.get("cwd"), str) else "") or "."
    start = Path(os.path.expanduser(start_dir)).resolve()
    if not start.is_dir():
        print(f"session-wrap: {start} is not a folder", file=sys.stderr)
        return 1
    root = sh.repo_root(start)
    base = root or start

    warnings: list[str] = []
    try:
        config = sh.load_config(env)
    except sh.ConfigError as exc:
        config = sh.Config(sh.config_path(env), False, {})
        warnings.append(f"config: {exc}, using defaults")
    project, _ = sh.resolve_project(args.project or None, env, base)
    folder = sh.notes_dir(env, base)
    now = dt.datetime.now().astimezone()
    since = sh.resolve_since(args.since, env, hook, folder, now)

    if args.skip_if_noted:
        if since.start is None:
            warnings.append("could not determine whether this session already has a note "
                            "(no session start time), writing one")
        else:
            recent = sh.notes_since(folder, since.start.timestamp())
            if recent:
                print(f"session-wrap: skipped, {sh.rel(recent[0], base)} was written after the session "
                      f"start ({sh.fmt_time(since.start)})")
                return 0

    changes, _ = _changes(sh, root, since)
    branch_text = "no git"
    head = "no commit"
    if root is not None:
        _, branch_text = sh.current_branch(root)
        branch_text = branch_text or "unknown branch"
        head = sh.head_short(root)
    template, problem = _template(sh, config, base)
    if problem:
        warnings.append(problem)
    values = {
        "project": project,
        "date": now.strftime("%Y-%m-%d"),
        "time": now.strftime("%H:%M"),
        "branch": branch_text,
        "head": head,
        "since": since.label,
        "changes": changes,
        "decisions": _bullets(args.decision, "none recorded"),
        "next": next_text or "Not given. Write the first thing the next session should do.",
        "questions": _bullets(args.question, "none recorded"),
    }
    body = string.Template(template).safe_substitute(values)

    path = _note_path(folder, now)
    try:
        folder.mkdir(parents=True, exist_ok=True)
        with open(path, "x", encoding="utf-8") as handle:
            handle.write(body if body.endswith("\n") else body + "\n")
    except OSError as exc:
        print(f"session-wrap: could not write {path}: {exc.strerror or exc}", file=sys.stderr)
        return 1
    for warning in warnings:
        print(f"session-wrap: {warning}")
    print(f"session-wrap: wrote {sh.rel(path, base)}, git log {since.label}")
    if not next_text:
        print("session-wrap: no next line given (use --next or stdin), the note says so")

    # ---- tracker ----
    if not next_text:
        print("tracker: nothing to send, the note has no next line")
        return 0
    where = f"{sh.rel(path, base)}, {branch_text} at {head}"
    message = f"{' '.join(next_text.split())} (session note: {where})"
    try:
        tracker = sh.load_tracker(config, env, base)
        plan = tracker.plan_post(project)
    except TrackerError as exc:
        print(f"tracker: could not determine: tracker ({exc})")
        return 1 if args.post else 0
    if not args.post:
        print(f"tracker: would {plan}:")
        print(f"  {message}")
        print("tracker: nothing sent (dry run). Add --post to send.")
        return 0
    try:
        url = tracker.post_note(project, message)
    except TrackerError as exc:
        print(f"tracker: NOT sent, {plan} failed: {exc}", file=sys.stderr)
        return 1
    print(f"tracker: sent, {plan}: {url or '(no link returned)'}")
    return 0


def main(argv: list[str] | None = None, stdin=None) -> int:
    return run(argv, stdin)


if __name__ == "__main__":
    sys.exit(main())
